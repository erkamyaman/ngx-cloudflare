{
  "name": "ngx-cloudflare-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:lib": "ng build ngx-cloudflare && tsc -p projects/ngx-cloudflare/tsconfig.schematics.json && node scripts/copy-package-files.mjs",
    "test:lib": "vitest run --config projects/ngx-cloudflare/vitest.angular.config.mts && vitest run --config projects/ngx-cloudflare/vitest.node.config.mts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "highlight": "node scripts/highlight-code-samples.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.10",
  "dependencies": {
    "@angular/cdk": "~22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "@ng-web-apis/common": "^5.4.1",
    "@ng-web-apis/platform": "^5.4.1",
    "@ng-web-apis/universal": "^5.4.1",
    "@taiga-ui/cdk": "^5.32.0",
    "@taiga-ui/core": "^5.32.0",
    "@taiga-ui/event-plugins": "^5.1.0",
    "@taiga-ui/i18n": "^5.32.0",
    "@taiga-ui/icons": "^5.32.0",
    "@taiga-ui/kit": "^5.32.0",
    "@taiga-ui/polymorpheus": "^5.0.1",
    "@taiga-ui/styles": "^5.32.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^24.19.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "~22.2.0",
    "prettier": "^3.8.1",
    "shiki": "^3.23.0",
    "typescript": "~7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.160.0",
    "xhr2": "^0.2.1"
  }
}
