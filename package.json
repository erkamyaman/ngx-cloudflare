{
  "name": "ngx-cloudflare-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "build:lib": "ng build ngx-cloudflare && tsc -p projects/ngx-cloudflare/tsconfig.schematics.json && node scripts/copy-package-files.mjs",
    "test:lib": "ng test ngx-cloudflare --watch=false && vitest run --config projects/ngx-cloudflare/vitest.node.config.mts",
    "db:migrate": "wrangler d1 migrations apply DB --local"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^22.20.5",
    "jsdom": "^30.0.0",
    "ng-packagr": "~22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.160.0",
    "xhr2": "^0.2.1"
  }
}
